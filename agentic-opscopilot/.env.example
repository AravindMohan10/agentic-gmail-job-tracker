# Copy this file to .env and fill in your values. Never commit .env.
# Required for sync:
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — defaults shown. Use absolute paths for scheduler.
# APPLICATIONS_DB_PATH=applications.db
# SYNC_EXCEL_PATH=applications.xlsx
# GMAIL_CREDENTIALS_FILE=credentials.json
# GMAIL_TOKEN_FILE=token.json
# SYNC_GMAIL_QUERY=
# SYNC_GMAIL_AFTER=   (default: today YYYY/MM/DD — only current-day mails; set to a date for older)
# SYNC_MAX_MESSAGES=100
# SYNC_MAX_EXTRACTIONS_PER_RUN=80   (max emails per run; assume up to 80 applications/day)
# SYNC_BATCH_SIZE=5                 (emails per LLM call; 80 emails = 16 calls, free-tier safe)
# GEMINI_THROTTLE_S=12

# Optional — log each run to a file for metrics (one line per run)
# SYNC_LOG_PATH=sync_run.log
